{
  "cli": { "version": ">= 14.0.0", "appVersionSource": "remote" },
  "build": {
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://pear-sandbox.everbetter.com"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://pear-sandbox.everbetter.com"
      }
    }
  }
}
