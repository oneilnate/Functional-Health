# Required environment variables for foodpod-api
# Copy this file to .env and fill in actual values
# Never commit .env to version control

# Google Gemini API key
GEMINI_API_KEY=

# ElevenLabs text-to-speech API key
ELEVENLABS_API_KEY=

# ElevenLabs voice ID for TTS synthesis (defaults to EXAVITQu4vr4xnSDxMaL = Sarah)
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Supabase project URL (e.g. https://xxxx.supabase.co) — used by Supabase JS client for Storage
SUPABASE_URL=

# Supabase session pooler Postgres URL — used by Drizzle ORM / postgres.js
# Get from: Supabase Dashboard → Project Settings → Database → Connection pooling
# Use Session mode (port 5432): postgresql://postgres.<project>:<pw>@aws-1-us-west-2.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# Supabase service role key (secret — server-side only)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase anon key (public — for client-visible ops)
SUPABASE_ANON_KEY=

# Shared bearer token for demo user authentication
DEMO_USER_BEARER_TOKEN=

# Server port (optional, defaults to 3000)
# PORT=3000

# Node environment: development | production | test (optional, defaults to development)
# NODE_ENV=development

